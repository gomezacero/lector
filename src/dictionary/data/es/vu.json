lnerar","partOfSpeech":"Verbo transitivo","definitions":["No cumplir lo que manda una ley, regla, mandato, precepto, etc.Quebrantar, transgredir, violar una ley o precepto.","Causar daño o perjuicio.","Producir una herida o contusión a un ser vivo."],"forms":["vulnerando","vulnerado","vulnero","vulneras","vulnerás","vulnera","vulneramos","vulneráis","vulneran","vulneraba","vulnerabas","vulnerábamos","vulnerabais","vulneraban","vulneré","vulneraste","vulneró","vulnerasteis","vulneraron","vulneraré","vulnerarás","vulnerará","vulneraremos","vulneraréis","vulnerarán","vulneraría","vulnerarías","vulneraríamos","vulneraríais","vulnerarían","vulnere","vulneres"],"pronunciation":"[bulneˈɾaɾ]"},"vulneraria":{"lemma":"vulneraria","partOfSpeech":"Sustantivo femenino","definitions":["(Anthyllis vulneraria) Especie de plantas europeas de tallo velludo, de hasta 50 cm de altura, hojas alternas, flores generalmente amarillas, crema, rosadas o anaranjadas y fruto consistente en una pequeña vaina ovoide. Son apreciadas por sus propiedades curativas, de donde derivan su nombre."],"forms":["vulnerarias"],"pronunciation":"[bulneˈɾaɾja]"},"vulnerario":{"lemma":"vulnerario","partOfSpeech":"Adjetivo","definitions":["Se dice de la planta o sustancia que tiene propiedades beneficiosas para curar heridas o llagas."],"forms":["vulnerarios","vulneraria","vulnerarias"],"pronunciation":"[bulneˈɾaɾjo]"},"vulpécula":{"lemma":"vulpécula","partOfSpeech":"Sustantivo femenino y epiceno","definitions":["Zorro."],"forms":["vulpéculas"],"pronunciation":"[bulˈpekula]"},"vulpeja":{"lemma":"vulpeja","partOfSpeech":"Sustantivo femenino y epiceno","definitions":["Zorro (animal)."],"forms":["vulpejas"],"pronunciation":"[bulˈpexa]"},"vulpino":{"lemma":"vulpino","partOfSpeech":"Adjetivo","definitions":["Propio de o relativo a los zorros.","Con características del zorro o que se asemeja a ellos."],"forms":["vulpinos","vulpina","vulpinas"],"pronunciation":"[bulˈpino]"},"vulto":{"lemma":"vulto","partOfSpeech":"Sust