ener familia, porque no podían ser vendidos; situación que lo asimilaba a un siervo de la gleba medieval.","Persona que no posee derechos como ciudadano."],"forms":["ilotas"],"pronunciation":"[iˈlot̪a]"},"ilu":{"lemma":"ilu","partOfSpeech":"Sustantivo femenino","definitions":["Vivo deseo de que algo suceda.","Alegría y entusiasmo que provoca un acontecimiento favorable."],"forms":[],"pronunciation":"[ˈilu]"},"iludido":{"lemma":"iludido","partOfSpeech":"Forma verbal","definitions":["Participio de iludir."],"forms":["iludidos","iludida","iludidas"],"pronunciation":"[iluˈð̞ið̞o]"},"iludiendo":{"lemma":"iludiendo","partOfSpeech":"Forma verbal","definitions":["Gerundio de iludir."],"forms":[],"pronunciation":"[iluˈð̞jẽn̪d̪o]"},"iludir":{"lemma":"iludir","partOfSpeech":"Verbo transitivo","definitions":["Hacer creer algo falso, crear a alguien alguna ilusión falsa."],"forms":["iludiendo","iludido","iludo","iludes","iludís","ilude","iludimos","iluden","iludía","iludías","iludíamos","iludíais","iludían","iludí","iludiste","iludió","iludisteis","iludieron","iludiré","iludirás","iludirá","iludiremos","iludiréis","iludirán","iludiría","iludirías","iludiríamos","iludiríais","iludirían","iluda","iludas"],"pronunciation":"[iluˈð̞iɾ]"},"ilufi":{"lemma":"Ilufi","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[iˈlufi]"},"ilufín":{"lemma":"Ilufín","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[iluˈfĩn]"},"ilumbe":{"lemma":"Ilumbe","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[iˈlũmbe]"},"iluminación":{"lemma":"iluminación","partOfSpeech":"Sustantivo femenino","definitions":["Acción o efecto de iluminar.","Conjunto de luces, colocadas de forma ordenada, que adornan un lugar.","Dícese de una clase pintura hecha al timple."],"forms":["iluminaciones"],"pronunciation":"[iluminaˈsjõn]"},"iluminadamente":{"lemma":"iluminadamente","partOfSpeech":"Adverbio de mo