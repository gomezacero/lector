{"entries":{"ñu":{"lemma":"ñu","partOfSpeech":"Sustantivo masculino","definitions":["(Connochaetes spp.) Bóvido africano de mediano tamaño y hábitos migratorios, que habita las llanuras del oriente de ese continente. Son notorios por su aspecto, con una joroba en la cruz, el pelaje muy irregular, una larga barba y los cuernos muy curvos. Forman grandes manadas dominadas por un macho reproductor."],"forms":["ñus","ñúes"],"pronunciation":"[ˈɲu]"},"ñublado":{"lemma":"ñublado","partOfSpeech":"Adjetivo","definitions":["Variante anticuada de nublado."],"forms":["ñublados","ñublada","ñubladas"],"pronunciation":"[ɲuˈβ̞lað̞o]"},"ñublando":{"lemma":"ñublando","partOfSpeech":"Forma verbal","definitions":["Gerundio de ñublar."],"forms":[],"pronunciation":"[ɲuˈβ̞lãn̪d̪o]"},"ñublándose":{"lemma":"ñublándose","partOfSpeech":"Forma verbal","definitions":["Gerundio de ñublar, con el pronombre «se» enclítico."],"forms":[],"pronunciation":"[ɲuˈβ̞lãn̪d̪ose]"},"ñublar":{"lemma":"ñublar","partOfSpeech":"Verbo transitivo","definitions":["Variante anticuada de nublar"],"forms":["ñublando","ñublado","ñublo","ñublas","ñublás","ñubla","ñublamos","ñubláis","ñublan","ñublaba","ñublabas","ñublábamos","ñublabais","ñublaban","ñublé","ñublaste","ñubló","ñublasteis","ñublaron","ñublaré","ñublarás","ñublará","ñublaremos","ñublaréis","ñublarán","ñublaría","ñublarías","ñublaríamos","ñublaríais","ñublarían","ñuble","ñubles"],"pronunciation":"[ɲuˈβ̞laɾ]"},"ñublarse":{"lemma":"ñublarse","partOfSpeech":"Verbo pronominal","definitions":["Variante anticuada de nublarse."],"forms":["ñublándose","ñublado","ñúblate","ñublate","ñúblese","ñublémonos","ñublaos","ñúblense"],"pronunciation":"[ɲuˈβ̞laɾse]"},"ñuble":{"lemma":"Ñuble","partOfSpeech":"Sustantivo propio","definitions":["Río de la zona central de Chile, que nace en los Andes y se une al río Itata tras unos 160 km de recorrido.","Región chilena donde se encuentra el río del mismo nombre, en la VIII región del Bío Bío, cuya capital es Chillán."],"forms":[],"