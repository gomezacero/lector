ma":"isótopo","partOfSpeech":"Sustantivo masculino","definitions":["Cada una de las especies de átomos de un elemento químico que poseen el mismo número atómico y distinto número másico."],"forms":["isótopos"],"pronunciation":"[iˈsot̪opo]"},"isotropía":{"lemma":"isotropía","partOfSpeech":"Sustantivo femenino","definitions":["La propiedad de ser idéntico en todas direcciones."],"forms":["isotropías"],"pronunciation":"[isot̪ɾoˈpia]"},"isotrópico":{"lemma":"isotrópico","partOfSpeech":"Adjetivo","definitions":["Que tiene propiedades que son idénticas en todas direcciones. Que tiene isotropía","Característica que posee el Universo de verse igual en todas direcciones sin importar la posición del o los observadores que se encuentren en él, ya que cualesquiera que sea su ubicación, estarán observando el mismo universo.","Es cuando el material del cual esta constituido un elemento estructural presenta propiedades invariables."],"forms":["isotrópicos","isotrópica","isotrópicas"],"pronunciation":"[isoˈt̪ɾopiko]"},"isotropismo":{"lemma":"isotropismo","partOfSpeech":"Sustantivo masculino","definitions":["Cualidad de presentar las mismas condiciones homogéneas de intensidad, variación, fuerza, brillo, forma, etc. en todas las direcciones.","Ausencia de orientación espacial preferente en un tejido visto microscópicamente.","Cualidad de la resolución espacial de la tomografía, cuando es idéntica en los tres ejes espaciales."],"forms":["isotropismos"],"pronunciation":"[isot̪ɾoˈpismo]"},"isótropo":{"lemma":"isótropo","partOfSpeech":"Adjetivo","definitions":["Isotrópico."],"forms":["isótropos","isótropa","isótropas"],"pronunciation":"[iˈsot̪ɾopo]"},"isouribehere":{"lemma":"Isouribehere","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[isowɾiβ̞eˈeɾe]"},"ispa":{"lemma":"ispa","partOfSpeech":"Sustantivo masculino","definitions":["País."],"forms":[],"pronunciation":"[ˈispa]"},"ispahán":{"lemma":"Ispahán","partOfSpeech":"Sustantivo propio","defini