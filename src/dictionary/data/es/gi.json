nóforos"],"pronunciation":"[xiˈnofoɾo]"},"ginseng":{"lemma":"ginseng","partOfSpeech":"Sustantivo masculino","definitions":["Cualquiera de las plantas del género Panax (Panax ginseng y Panax quinquefolius), de cuyas raíces ramificadas se extrae una sustancia que se supone que tiene propiedades medicinales y afrodisíacas.","Las raíces del ginseng."],"forms":["ginsengs"],"pronunciation":"[xĩnˈsẽŋ]"},"gioconda":{"lemma":"Gioconda","partOfSpeech":"Sustantivo propio","definitions":["Nombre de pila de mujer."],"forms":[],"pronunciation":"[xjoˈkõn̪d̪a]"},"gira":{"lemma":"gira","partOfSpeech":"Sustantivo femenino","definitions":["Tour."],"forms":["giras"],"pronunciation":"[ˈxiɾa]"},"girado":{"lemma":"girado","partOfSpeech":"Forma verbal","definitions":["Participio de girar."],"forms":["girados","girada","giradas"],"pronunciation":"[xiˈɾað̞o]"},"giralde":{"lemma":"Giralde","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[xiˈɾal̪d̪e]"},"giraldi":{"lemma":"Giraldi","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[xiˈɾal̪d̪i]"},"giraldilla":{"lemma":"giraldilla","partOfSpeech":"Sustantivo femenino","definitions":["Baile que consta de una parte en círculo (lo ritual) alternada con un baile a lo suelto por parejas (lo lúdico)."],"forms":["giraldillas"],"pronunciation":"[xiɾal̪ˈd̪iʝa]"},"giraldo":{"lemma":"Giraldo","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[xiˈɾal̪d̪o]"},"giralt":{"lemma":"Giralt","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[xiˈɾal̪t̪]"},"girando":{"lemma":"girando","partOfSpeech":"Forma verbal","definitions":["Gerundio de girar."],"forms":[],"pronunciation":"[xiˈɾãn̪d̪o]"},"girar":{"lemma":"girar","partOfSpeech":"Verbo transitivo · Verbo intransitivo","definitions":["Hacer mover a algún objeto en forma de círculo alrededor de un eje o centro.","Transferir dinero.","Remitir una orden de