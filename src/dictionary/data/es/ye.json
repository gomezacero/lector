"yesar","partOfSpeech":"Sustantivo masculino","definitions":["Terreno abundante en mineral de yeso que se puede beneficiar.","Cantera de yeso o aljez."],"forms":["yesares"],"pronunciation":"[ʝeˈsaɾ]"},"yesca":{"lemma":"yesca","partOfSpeech":"Sustantivo femenino","definitions":["Materia muy seca y preparada de manera que cualquiera chispa de fuego prenda en ella. Comúnmente se hace de trapo quemado, cardo u hongos secos.","Cosa que está sumamente seca, y por lo tanto dispuesta a encenderse o abrasarse.","Incentivo de cualquier pasión o afecto.","Cualquier cosa que excita la gana de beber, y con singularidad, de beber vino.","Pobre, sin dinero."],"forms":["yescas"],"pronunciation":"[ˈʝeska]"},"yesenia":{"lemma":"Yesenia","partOfSpeech":"Sustantivo propio","definitions":["Nombre de pila de mujer."],"forms":[],"pronunciation":"[ʝeˈsenja]"},"yesera":{"lemma":"yesera","partOfSpeech":"Sustantivo femenino","definitions":["Variante de yesar."],"forms":["yeseras"],"pronunciation":"[ʝeˈseɾa]"},"yesería":{"lemma":"yesería","partOfSpeech":"Sustantivo femenino","definitions":["Lugar donde se fabrica yeso","Lugar donde se vende yeso","Obra realizada con yeso"],"forms":["yeserías"],"pronunciation":"[ʝeseˈɾia]"},"yesero":{"lemma":"yesero","partOfSpeech":"Sustantivo masculino y femenino · Adjetivo","definitions":["El que fabrica, vende, ó conduce el yeso al sitio donde se está haciendo obra.","El que hace guarnecidos de yeso.","Que pertenece o concierne al yeso."],"forms":["yeseros","yesera","yeseras"],"pronunciation":"[ʝeˈseɾo]"},"yesgo":{"lemma":"yesgo","partOfSpeech":"Sustantivo masculino","definitions":["(Sambucus ebulus) Hierba de la familia de las caprifoliáceas, crece hasta dos metros con tallos erectos; el fruto es una baya tóxica, de color negro, pequeña y globosa de 5 a 6mm de diámetro."],"forms":["yesgos"],"pronunciation":"[ˈʝesɣ̞o]"},"yeshivá":{"lemma":"yeshivá","partOfSpeech":"Sustantivo masculino","definitions":["Centro de estudios de la Torá y del Talmud generalmente dirigida a varones en el judaísmo ortodoxo. También se las suele conocer como escuelas talmúdicas."],"forms":["yeshivás"],"pronunciation":"[ʝeʃiˈβ̞a]"},"yeso":{"lemma":"yeso","partOfSpeech":"Sustantivo masculino · Sustantivo propio","definitions":["Mineral muy blando, compuesto primariamente de dihidrato de sulfato de calcio (fórmula: CaSO₄·2H₂O), de hábito cristalino prismático, monoclínico, de color blanco, transparente a translúcido, usado desde la Antigüedad para construcción y como aditivo en diversos procesos culinarios.","Polvo de yeso₁ deshidratado, usado como material de construcción, especialmente en revestimientos y piezas decorativas.","Obra escultórica vaciada en yeso₂.","Vendaje impregnado de yeso₂ que se emplea para inmovilizar un miembro en caso de fracturas o fisuras de los huesos.","Apellido."],"forms":["yesos"],"pronunciation":"[ˈʝeso]"},"yesón":{"lemma":"yesón","partOfSpeech":"Sustantivo masculino","definitions":["Pedazo de yeso que se saca de las fábricas que se derriban ó caen, y sirve para hacer tabicones, lienzos de chimeneas, etc."],"forms":["yesones"],"pronunciation":"[ʝeˈsõn]"},"yesquero":{"lemma":"yesquero","partOfSpeech":"Adjetivo · Sustantivo masculino y femenino","definitions":["Que pertenece o concierne a la yesca.","Fabricante o comerciante de yesca.","Herramienta utilizada para encender el fuego, que usa la yesca como combustible.","Bolsa utilizada para llevar la yesca y el pedernal."],"forms":["yesqueros","yesquera","yesqueras"],"pronunciation":"[ʝesˈkeɾo]"},"yessa":{"lemma":"Yessa","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ˈʝesa]"},"yessica":{"lemma":"Yessica","partOfSpeech":"Sustantivo propio","definitions":["Nombre de pila de mujer."],"forms":[],"pronunciation":"[ʝeˈsika]"},"yeta":{"lemma":"yeta","partOfSpeech":"Sustantivo femenino · Sustantivo masculino y femenino","definitions":["Racha de mala suerte, serie de desgracias, infortunio permanente que, supersticiosamente, se considera ligado a una persona.","Portador de mala suerte."],"forms":["yetas"],"pronunciation":"[ˈʝet̪a]"},"yetar":{"lemma":"yetar","partOfSpeech":"Verbo transitivo","definitions":["Imbuir o traspasar la yeta, o mala suerte, a una persona o situación."],"forms":["yetando","yetado","yeto","yetas","yetás","yeta","yetamos","yetáis","yetan","yetaba","yetabas","yetábamos","yetabais","yetaban","yeté","yetaste","yetó","yetasteis","yetaron","yetaré","yetarás","yetará","yetaremos","yetaréis","yetarán","yetaría","yetarías","yetaríamos","yetaríais","yetarían","yete","yetes"],"pronunciation":"[ʝeˈt̪aɾ]"},"yetatore":{"lemma":"yetatore","partOfSpeech":"Adjetivo","definitions":["Variante de yeta."],"forms":["yetatores"],"pronunciation":"[ʝet̪aˈt̪oɾe]"},"yeti":{"lemma":"yeti","partOfSpeech":"Sustantivo masculino","definitions":["En la mitología tibetana, simio de pelaje blanco y postura erguida que habita el Himalaya."],"forms":["yetis"],"pronunciation":"[ˈʝet̪i]"},"yeucun":{"lemma":"Yeucun","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ˈʝewkũn]"},"yevialo":{"lemma":"Yevialo","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ʝeˈβ̞jalo]"},"yevil":{"lemma":"Yevil","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ʝeˈβ̞il]"},"yevila":{"lemma":"Yevila","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ʝeˈβ̞ila]"},"yevilaf":{"lemma":"Yevilaf","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ʝeβ̞iˈlaf]"},"yevilao":{"lemma":"Yevilao","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ʝeβ̞iˈlao]"},"yevileo":{"lemma":"Yevileo","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ʝeβ̞iˈleo]"},"yevul":{"lemma":"Yevul","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ʝ