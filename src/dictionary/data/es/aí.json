{"entries":{"aí":{"lemma":"aí","partOfSpeech":"Sustantivo masculino","definitions":["(Bradypus tridactylus) Una de las especies de perezosos que vive en la cuenca del Orinoco y en la del Amazonas. Tiene el pelaje parduzco, grisáceo y áspero con manchas blancas en el rostro y oscuras a través de las orejas y el pelaje. Posee una cola corta y las extremidades superiores son más largas que las inferiores, cada pata posee tres dedos, de ahí su nombre."],"forms":["aís","aíes"],"pronunciation":"[aˈi]"},"aída":{"lemma":"Aída","partOfSpeech":"Sustantivo propio","definitions":["Nombre de pila de mujer."],"forms":[],"pronunciation":"[aˈið̞a]"},"aíllo":{"lemma":"aíllo","partOfSpeech":"Sustantivo","definitions":["Cierto grupo de parentesco.^([cita requerida])"],"forms":[],"pronunciation":"[aˈiʝo]"},"aína":{"lemma":"aína","partOfSpeech":"Adverbio de tiempo · Adverbio de cantidad · Adverbio de modo","definitions":["Presto, pronto.","Por poco.","Fácilmente."],"forms":[],"pronunciation":"[aˈina]"}},"aliases":{"aíes":"aí","aíndia":"aindiar","aíndian":"aindiar","aíndias":"aindiar","aíndiate":"aindiarse","aíndie":"aindiar","aíndien":"aindiar","aíndiense":"aindiarse","aíndies":"aindiar","aíndiese":"aindiarse","aíndio":"aindiar","aíra":"airar","aíran":"airar","aíras":"airar","aírate":"airarse","aíre":"airar","aíren":"airar","aírense":"airarse","aíres":"airar","aírese":"airarse","aíro":"airar","aís":"aí","aísla":"aislar","aíslan":"aislar","aíslas":"aislar","aíslate":"aislarse","aísle":"aislar","aíslen":"aislar","aíslense":"aislarse","aísles":"aislar","aíslese":"aislarse","aíslo":"aislar"}}
