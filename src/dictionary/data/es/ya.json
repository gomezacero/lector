artOfSpeech":"Adjetivo · Sustantivo masculino","definitions":["Que pertenece o concierne a un pueblo nómada amerindio que habitaba las islas y canales al sur de Tierra del Fuego, entre el Canal Beagle y el Cabo de Hornos. Sobreviven unos pocos descendientes.","Lengua sudamericana hablada por los yaganes. No ha sido relacionada satisfactoriamente con otras lenguas. En el año 2006 sólo una mujer anciana es capaz de hablarla."],"forms":["yaganes","yagana","yaganas"],"pronunciation":"[ʝaˈɣ̞ãn]"},"yagé":{"lemma":"yagé","partOfSpeech":"Sustantivo masculino","definitions":["Ayahuasca."],"forms":["yagés"],"pronunciation":"[ʝaˈxe]"},"yago":{"lemma":"Yago","partOfSpeech":"Sustantivo propio","definitions":["Nombre de pila de varón.","Apellido."],"forms":[],"pronunciation":"[ˈʝaɣ̞o]"},"yagrumo":{"lemma":"yagrumo","partOfSpeech":"Sustantivo masculino","definitions":["(Cecropia schreberiana, Cecropia peltata) Árbol de tronco no muy grueso, altura de unos veinte metros; hojas siempre verdes, gruesas y de gran tamaño, que por su envés presentan frecuentemente un hermoso color plateado. Su madera es blanda y poco duradera, se utiliza para fabricar el cuatro, instrumento de cuerdas venezolano, portorriqueño y de otros países, y para fabricar palitos de fósforo. Es el alimento preferido del animal llamado perezoso. Vive en el Caribe, América Central, Venezuela y otros países de la zona intertropical americana."],"forms":["yagrumos"],"pronunciation":"[ʝaˈɣ̞ɾumo]"},"yaguané":{"lemma":"yaguané","partOfSpeech":"Adjetivo","definitions":["Dicho del pelaje del yeguarizo, que tiene el cuerpo cruzado por largas tiras o fajas blancas y el resto del cuerpo negro o colorado."],"forms":["yaguanés"],"pronunciation":"[ʝaɣ̞waˈne]"},"yaguar":{"lemma":"yaguar","partOfSpeech":"Sustantivo masculino","definitions":["(Panthera onca) Felino sudamericano de gran tamaño, el mayor del mundo tras el león y el tigre y una de las cuatro especies capaces de rugir gracias a la peculiar conformación de su hioides. Es distintiva su piel moteada con rosetas de color negro sobre fondo dorado, aunque existen ejemplares con melanismo, completamente negros. Son predadores solitarios, que cazan en la selva y junto a los ríos, sin tener competencia de ninguna otra especie en su ecosistema. Su mordida es especialmente poderosa, adaptada para partir el cráneo o el cuello de sus presas, incluso bestias de gran tamaño como la anaconda."],"forms":["yaguares"],"pronunciation":"[ʝaˈɣ̞waɾ]"},"yaguareté":{"lemma":"yaguareté","partOfSpeech":"Sustantivo masculino","definitions":["(Panthera onca) Felino sudamericano de gran tamaño, el mayor del mundo tras el león y el tigre y una de las cuatro especies capaces de rugir gracias a la peculiar conformación de su hioides. Es distintiva su piel moteada con rosetas de color negro sobre fondo dorado, aunqu existen ejemplares con melanismo, completamente negros. Son predadores solitarios, que cazan en la selva y junto a los ríos, sin tenr competencia de ninguna otra especie en su ecosistema. Su mordida es especialmente poderosa, adaptada para partir el cráneo o el cuello de sus presas, incluso bestias de gran tamaño como la anaconda."],"forms":["yaguaretés"],"pronunciation":"[ʝaɣ̞waɾeˈt̪e]"},"yaguarundí":{"lemma":"yaguarundí","partOfSpeech":"Sustantivo masculino","definitions":["(Herpailurus yagouaroundi) Especie de felino americano de cuerpo largo y esbelto con miembros cortos y cola larga. La cabeza es pequeña y plana con orejas también pequeñas y redondeadas. Pelaje corto y áspero, que va de pardo a negro uniforme. Los pelos tienden a ser claros en la base y en la punta dando apariencia entrecana. Carece de manchas o líneas."],"forms":["yaguarundís","yaguarundíes"],"pronunciation":"[ʝaɣ̞waɾũn̪ˈd̪i]"},"yaguasa":{"lemma":"yaguasa","partOfSpeech":"Sustantivo femenino","definitions":["(Dendrocygna arborea) Ave palmípeda americana, especie de pato, de unos 51 cm de longitud, que se caracteriza por tener el cuello y las patas largas, y que mantiene en ángulo hacia abajo mientras vuela. El plumaje es de color canela y manto negro, ampliamente escamado."],"forms":["yaguasas"],"pronunciation":"[ʝaˈɣ̞wasa]"},"yaguatirica":{"lemma":"yaguatirica","partOfSpeech":"Sustantivo masculino","definitions":["Especie de mamífero carnívoro de la familia Felidae ampliamente distribuido por América."],"forms":["yaguatiricas"],"pronunciation":"[ʝaɣ̞wat̪iˈɾika]"},"yague":{"lemma":"Yague","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ˈʝaɣ̞e]"},"yaguez":{"lemma":"Yaguez","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ʝaˈɣ̞es]"},"yagulen":{"lemma":"Yagulen","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ʝaˈɣ̞ulẽn]"},"yah":{"lemma":"Yah","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ˈʝa]"},"yahvé":{"lemma":"Yahvé","partOfSpeech":"Sustantivo propio y masculino","definitions":["El nombre de Dios en el Tanaj."],"forms":[],"pronunciation":"[ʝaˈβ̞e]"},"yak":{"lemma":"yak","partOfSpeech":"Sustantivo masculino","definitions":["Bóvido de gran tamaño y pelaje lanoso nativo de las montañas de Asia Central y el Himalaya. Es un animal gregario de pelo invariablemente largo y negro, con una joroba sobre los hombros y cuernos largos."],"forms":["yaks"],"pronunciation":"[ˈʝak]"},"yakarta":{"lemma":"Yakarta","partOfSpeech":"Sustantivo propio","definitions":["Ciudad capital de Indonesia."],"forms":[],"pronunciation":"[ʝaˈkaɾt̪a]"},"yakibuta":{"lemma":"yakibuta","partOfSpeech":"Sustantivo femenino","definitions":["Pedazo de carne de cerdo cocinada en salsa de soja durante un par de horas, que luego se puede comer como plato principal o bien usarse para preparar ramen."],"forms":["yakibutas"],"pronunciation":"[ʝakiˈβ̞ut̪a]"},"yakimono":{"lemma":"yakimono","partOfSpeech":"Sustantivo masculino","definitions":["variedad de cocina japonesa que elabora los productos a la parrilla. Platos como el teppanyaki o el yakitori son de este tipo."],"forms":[],"pronunciation":"[ʝakiˈmono]"},"yakisoba":{"lemma":"yakisoba","partOfSpeech":"Sustantivo femenino","definitions":["Plato hecho fundamentalmente con fideos, carne de chancho y vegetales; todo frito y acompañado de una salsa dulce."],"forms":["yakisobas"],"pronunciation":"[ʝakiˈsoβ̞a]"},"yakitori":{"lemma":"yakitori","partOfSpeech":"Sustantivo masculino","definitions":["Un plato japonés hecho con pequeños trozos de pollo cocido en brochetas, a menudo marinados en salsa de soja o sazonados con sal."],"forms":["yakitoris"],"pronunciation":"[ʝakiˈt̪oɾi]"},"yaksic":{"lemma":"Yaksic","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ʝakˈsik]"},"yakuto":{"lemma":"yakuto","partOfSpeech":"Sustantivo masculino","definitions":["Idioma túrquico hablado en Sajá, región de Rusia, por 456 288 hablantes."],"forms":[],"pronunciation":"[ʝaˈkut̪o]"},"yakuza":{"lemma":"yakuza","partOfSpeech":"Sustantivo masculino","definitions":["Mafia japonesa","Cada uno de sus miembros"],"forms":["yakuzas"],"pronunciation":"[ʝaˈkusa]"},"yal":{"lemma":"yal","partOfSpeech":"Sustantivo masculino","definitions":["(Melanodera spp., Phrygilus spp.) Cualquiera de varias aves de la familia de los tráupidos, nativas de la región andina en el nuevo mundo.","(Phrygilus fruticeti fruticeti ( Kittlitz )) Ave de 18-19cm de color apizarrado o gris en la cabeza, lomo y partes superiores, pecho y garganta aún más oscuros, casi negros, y vientre más claro, hasta el color blanco; pico y patas amarillas. Esto es en el macho. La hembra tiene las patas y pico marrón oscuro, con rayas oscuras sobre la cabeza y lomo, y rayas marrones en sus partes inferiores. Habita de Arica a Tierra del Fuego. Suele andar en bandadas."],"forms":["yales"],"pronunciation":"[ˈʝal]"},"yaldebere":{"lemma":"Yaldebere","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ʝal̪d̪eˈβ̞eɾe]"},"yalo":{"lemma":"yalo","partOfSpeech":"Contracción","definitions":["Ya lo creo."],"forms":[],"pronunciation":"[ˈʝalo]"},"yalpe":{"lemma":"Yalpe","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ˈʝalpe]"},"yalpi":{"lemma":"Yalpi","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ˈʝalpi]"},"yalta":{"lemma":"Yalta","partOfSpeech":"Sustantivo propio","definitions":["es una ciudad de Ucrania, en Crimea."],"forms":[],"pronunciation":"[ˈʝal̪t̪a]"},"yambo":{"lemma":"yambo","partOfSpeech":"Sustantivo masculino","definitions":["En poesía, pie formado por una sílaba corta y otra larga.","(Syzygium jambos) Árbol de la familia de las mirtáceas, nativo de la India y naturalizado en América tropical. Muestra hojas opuestas, lanceoladas e inflorescencia corimbosa, que fructifica en una baya redonda, de 2 a 5 cm de diámetro, de color amarillo verdoso, a veces algo rojizo. Su pulpa es de sabor agradable, blanca y firme."],"forms":["yambos"],"pronunciation":"[ˈʝãmbo]"},"yambú":{"lemma":"yambú","partOfSpeech":"Sustantivo masculino","definitions":["Género musical, rumba de origen cubano de movimientos muy enérgicos, se caracteriza por las fuertes insinuaciones sensuales."],"forms":[],"pronunciation":"[ʝãmˈbu]"},"yamcaman":{"lemma":"Yamcaman","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ʝãmˈkamãn]"},"yamel":{"lemma":"Yamel","partOfSpeech":"Sustantivo propio","definitions":["Nombre de pila de mujer."],"forms":[],"pronunciation":"[ʝaˈmel]"},"yamena":{"lemma":"Yamena","partOfSpeech":"Sustantivo propio","definitions":["Capital de Chad."],"forms":[],"pronunciation":"[ʝaˈmena]"},"yamil":{"lemma":"Yamil","partOfSpeech":"Sustantivo propio","definitions":["Nombre de pila de varón."],"forms":[],"pronunciation":"[ʝaˈmil]"},"yamila":{"lemma":"Yamila","partOfSpeech":"Sustantivo propio","definitions":["Nombre de pila de mujer."],"forms":[],"pronunciation":"[ʝaˈmila]"},"yamín":{"lemma":"Y