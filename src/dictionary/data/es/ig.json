,"ignorando":{"lemma":"ignorando","partOfSpeech":"Forma verbal","definitions":["Gerundio de ignorar."],"forms":[],"pronunciation":"[iɣ̞noˈɾãn̪d̪o]"},"ignorante":{"lemma":"ignorante","partOfSpeech":"Adjetivo","definitions":["Falto de conocimiento, inteligencia, madurez, o educación.","Que no tiene conocimiento o información de un tema en particular."],"forms":["ignorantes"],"pronunciation":"[iɣ̞noˈɾãn̪t̪e]"},"ignoranza":{"lemma":"ignoranza","partOfSpeech":"Sustantivo femenino","definitions":["Ignorancia."],"forms":["ignoranzas"],"pronunciation":"[iɣ̞noˈɾãnsa]"},"ignorar":{"lemma":"ignorar","partOfSpeech":"Verbo transitivo","definitions":["Desconocer algo, o carecer de noticias de ello","No prestar atención a alguien."],"forms":["ignorando","ignorado","ignoro","ignoras","ignorás","ignora","ignoramos","ignoráis","ignoran","ignoraba","ignorabas","ignorábamos","ignorabais","ignoraban","ignoré","ignoraste","ignoró","ignorasteis","ignoraron","ignoraré","ignorarás","ignorará","ignoraremos","ignoraréis","ignorarán","ignoraría","ignorarías","ignoraríamos","ignoraríais","ignorarían","ignore","ignores"],"pronunciation":"[iɣ̞noˈɾaɾ]"},"ignosticismo":{"lemma":"ignosticismo","partOfSpeech":"Sustantivo masculino","definitions":["La ignorancia de cualquier conocimiento sobre un Dios o dioses debido a la conclusión de que el teísmo carece de una definición coherente de lo que es dios."],"forms":[],"pronunciation":"[iɣ̞nost̪iˈsismo]"},"ignoto":{"lemma":"ignoto","partOfSpeech":"Adjetivo","definitions":["Desconocido.","No descubierto."],"forms":["ignotos","ignota","ignotas"],"pronunciation":"[iɣ̞ˈnot̪o]"},"igoa":{"lemma":"Igoa","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[iˈɣ̞oa]"},"igoaran":{"lemma":"Igoaran","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[iɣ̞oˈaɾãn]"},"igola":{"lemma":"Igola","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[iˈɣ̞ola]"},"igon":{"lemma":"Igon","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ˈiɣ̞õn]"},"igor":{"lemma":"Igor","partOfSpeech":"Sustantivo propio","definitions":["Nombre de pila de varón.","Apellido."],"forms":[],"pronunciation":"[iˈɣ̞oɾ]"},"iguado":{"lemma":"iguado","partOfSpeech":"Forma verbal","definitions":["Participio de iguar."],"forms":["iguados","iguada","iguadas"],"pronunciation":"[iˈɣ̞wað̞o]"},"iguain":{"lemma":"Iguain","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[ˈiɣ̞wãjn]"},"igual":{"lemma":"igual","partOfSpeech":"Adjetivo · Sustantivo masculino · Adverbio de modo · Adverbio de duda","definitions":["De la misma naturaleza, cantidad o calidad que otra cosa.","Liso, que no tiene cuestas ni profundidades. Al mismo nivel.","Que tiene las mismas o comparables características en cualidad, tamaño o aspecto. Muy parecido.","Proporcionado, en conveniente relación.","Que no varía, que se mantiene en una misma condición a lo largo del tiempo.","Que tiene el mismo valor, que se aprecia con la misma intensidad.","De la misma clase o condición.","Se aplica a las figuras que se pueden superponer de modo que coincidan en su totalidad.","Dicho de una cantidad, equivalente o idéntica a otra.","Signo de la igualdad (=).","Del mismo modo, de la misma manera o forma.","Sin importar las circunstancias. A pesar de todo, como sea, de todos modos."],"forms":["iguales"],"pronunciation":"[iˈɣ̞wal]"},"iguala":{"lemma":"iguala","partOfSpeech":"Sustantivo femenino","definitions":["Acción o efecto de igualar o de igualarse.","Composición, ajuste o pacto en los tratos. A menudo tiene que ver con la divisón en partes iguales de algo.","Estipendio o cosa que se da o paga para ajustar alguna cuenta, deuda o servicio.","Listón de madera con que los albañiles reconocen la llanura de las tapias, paredes o suelos.","Acuerdo entre médico y paciente por el que este hace un pago fijo a cambio de todas sus consultas o visitas. También se aplica a los planes o seguros de salud que operan con este sistema de pago."],"forms":["igualas"],"pronunciation":"[iˈɣ̞wala]"},"igualación":{"lemma":"igualación","partOfSpeech":"Sustantivo femenino","definitions":["Acción o efecto de igualar o de igualarse.","Convenio, ajuste o concordia. A menudo tiene que ver con dividir algo en partes iguales."],"forms":["igualaciones"],"pronunciation":"[iɣ̞walaˈsjõn]"},"igualada":{"lemma":"Igualada","partOfSpeech":"Sustantivo propio y femenino · Sustantivo propio · Sustantivo femenino","definitions":["Población de Cataluña, España, capital de la comarca del Anoia, a 67 kilómetros de Barcelona.","Apellido.","Acción o efecto de igualar o empatar en cantidad de puntos dentro de una competencia.","Acción o efecto de igualar al toro en tauromaquia (hacer que quede parado sobre sus cuatro patas para proceder a su ejecución con la espada)."],"forms":["igualadas"],"pronunciation":"[iɣ̞waˈlað̞a]"},"igualadino":{"lemma":"igualadino","partOfSpeech":"Adjetivo","definitions":["Originario, relativo a, o propio de Igualada, España."],"forms":["igualadinos","igualadina","igualadinas"],"pronunciation":"[iɣ̞walaˈð̞ino]"},"igualado":{"lemma":"igualado","partOfSpeech":"Adjetivo · Forma verbal","definitions":["Se dice de un ave que ya ha arrojado el plumón y tiene igual la pluma.","Se dice de una persona que se comporta como si perteneciera a una clase social más alta o que se toma derechos, privilegios o atribuciones que no le corresponden, especialmente en su forma de interactuar con otros y por actuar de manera descortés o arrogante.","Participio de igualar."],"forms":["igualados","igualada","igualadas"],"pronunciation":"[iɣ̞waˈlað̞o]"},"igualador":{"lemma":"igualador","partOfSpeech":"Adjetivo","definitions":["Que iguala (en sus diversas acepciones)."],"forms":["igualadores","igualadora","igualadoras"],"pronunciation":"[iɣ̞walaˈð̞oɾ]"},"igualamiento":{"lemma":"igualamiento","partOfSpeech":"Sustantivo masculino","definitions":["Acción o efecto de igualar o de igualarse."],"forms":["igualamientos"],"pronunciation":"[iɣ̞walaˈmjẽn̪t̪o]"},"igualando":{"lemma":"igualando","partOfSpeech":"Forma verbal","definitions":["Gerundio de igualar."],"forms":[],"pronunciation":"[iɣ̞waˈlãn̪d̪o]"},"igualándose":{"lemma":"igualándose","partOfSpeech":"Forma verbal","definitions":["Gerundio de igualar, con el pronombre «se» enclítico."],"forms":[],"pronunciation":"[iɣ̞waˈlãn̪d̪ose]"},"igualante":{"lemma":"igualante","partOfSpeech":"Adjetivo","definitions":["Que iguala."],"forms":[],"pronunciation":"[iɣ̞waˈlãn̪t̪e]"},"igualanza":{"lemma":"igualanza","partOfSpeech":"Sustantivo femenino","definitions":["Igualdad (en sus diferentes acepciones}.","Iguala (en sus diferentes acepciones}."],"forms":["igualanzas"],"pronunciation":"[iɣ̞waˈlãnsa]"},"igualar":{"lemma":"igualar","partOfSpeech":"Verbo transitivo · Verbo intransitivo","definitions":["Poner un ser al mismo nivel o en igualdad con otro. Hacerlos iguales en categoría, condición, apariencia o características.","Juzgar sin diferencia, o estimar a uno y tenerlo en la misma opinión o aprecio que a otro.","Hacer que la tierra, el suelo o alguna superficie queden parejos o lisos, sin altos ni bajos, sin cuestas ni huecos.","Hacer ajuste o convenirse con pacto sobre alguna cosa.","Hacer que el toro quede parado sobre sus cuatro patas para proceder a su ejecución con la espada.","Ser igual (con la misma naturaleza, condición, cantidad o calidad) a otro."],"forms":["igualando","igualado","igualo","igualas","igualás","iguala","igualamos","igualáis","igualan","igualaba","igualabas","igualábamos","igualabais","igualaban","igualé","igualaste","igualó","igualasteis","igualaron","igualaré","igualarás","igualará","igualaremos","igualaréis","igualarán","igualaría","igualarías","igualaríamos","igualaríais","igualarían","iguale","iguales"],"pronunciation":"[iɣ̞waˈlaɾ]"},"igualarse":{"lemma":"igualarse","partOfSpeech":"Verbo pronominal","definitions":["Ponerse, o comportarse como si se estuviera, al mismo nivel o en igualdad con otro. Hacerse igual en categoría, condición, apariencia o características.","Ser igual (con la misma naturaleza, condición, nivel, cantidad o calidad) a otro."],"forms":["igualándose","igualado","iguálate","igualate","iguálese","igualémonos","igualaos","iguálense"],"pronunciation":"[iɣ̞waˈlaɾse]"},"igualatorio":{"lemma":"igualatorio","partOfSpeech":"Adjetivo · Sustantivo masculino","definitions":["Que ayuda o tiende a la igualdad.","Convenio o asociación para recibir asistencia y servicios de salud a cambio de un pago fijo periódico."],"forms":["igualatorios","igualatoria","igualatorias"],"pronunciation":"[iɣ̞walaˈt̪oɾjo]"},"igualdad":{"lemma":"igualdad","partOfSpeech":"Sustantivo femenino","definitions":["Simetría o conformidad de algo en comparación con otra cosa en cuanto a su naturaleza, forma, calidad, cantidad, valor, etc. Condición o carácter de igual.","Trato justo y equitativo para todos los individuos de un grupo.","Condición o cualidad de tener el mismo valor que otra cantidad o expresión.","Correspondencia y proporción que resulta de muchas partes que uniformemente componen un todo.","Dicho de una superficie o terreno, condición o cualidad de no tener altibajos, de ser liso, uniforme, terso, parejo o plano."],"forms":["igualdades"],"pronunciation":"[iɣ̞wal̪ˈd̪að̞]"},"igualdo":{"lemma":"Igualdo","partOfSpeech":"Sustantivo propio","definitions":["Apellido."],"forms":[],"pronunciation":"[iˈɣ̞wal̪d̪o]"},"igualeza":{"lemma":"igualeza","partOfSpeech":"Sustantivo femenino","definitions":["Igualdad (en sus diferentes acepciones)."],"forms":["igualezas"],"pronunciation":"[iɣ̞waˈlesa]"},"igualitario":{"lemma":"igualitario","partOfSpeech":"Adjetivo","definitions":["Que pertenece o concierne a la igualdad (condición o carácter de igual; el hecho de ser lo mismo o muy parecido; el hecho de tener el mismo valor).","Que promueve, favorece o tiende a la igualdad.","Que promueve, favorece o defiende el trato justo y equitativo de la gente; que ayuda a la equidad o igualdad social, de derechos, ante la ley, etc."],"forms":["igualitarios","igualitaria","igualitarias"],"pronunciation":"[iɣ̞waliˈt̪aɾjo]"},"igualitarismo":{"lemma":"igualitarismo","partOfSpeech":"Sustantivo masculino","definitions":["Ideología social y política que promueve la igualdad ante la ley, el derecho a que todos los seres humanos tengan las mismas oportunidades, y la disminución de la distancia entre clases socioeconómicas."],"forms":["igualitarismos"],"pronunciation":"[iɣ̞walit̪aˈɾismo]"},"igualitico":{"lemma":"igualitico","partOfSpeech":"Adjetivo","definitions":["Diminutivo de igualito.","Extremadamente parecido, semejante o similar; casi idéntico o indistinguible."],"forms":["igualiticos","igualitica","igualiticas"],"pronunciation":"[iɣ̞waliˈt̪iko]"},"igualito":{"lemma":"igualito","partOfSpeech":"Adjetivo","definitions":["Diminutivo de igual.","Extremadamente parecido, semejante o similar; casi idéntico."],"forms":["igualitos","igualita","igualitas"],"pronunciation":"[iɣ̞waˈlit̪o]"},"igualmente":{"lemma":"igualmente","partOfSpeech":"Adverbio de modo","definitions":["De manera igual, con igualdad o equivalencia.","Del mismo modo o estilo, de la misma manera o forma, así."],"forms":[],"pronunciation":"[iˌɣ̞walˈmẽn̪t̪e]"},"igualón":{"lemma":"igualón","partOfSpeech":"Adjetivo","definitions":["Se dice de ciertas aves domésticas, como la gallina o la perdiz, que ya tienen casi el mismo tamaño de sus padres o del ejemplar adulto."],"forms":["igualones","igualona","igualonas"],"pronunciation":"[iɣ̞waˈlõn]"},"igualteco":{"lemma":"igualteco","partOfSpeech":"Adjetivo","definitions":["Originario, relativo a, o propio de Iguala, Guerrero, México."],"forms":["igualtecos","igualteca","igualtecas"],"pronunciation":"[iɣ̞wal̪ˈt̪eko]"},"iguana":{"lemma":"iguana","partOfSpeech":"Sustantivo femenino y epiceno","definitions":["(Iguana spp.) Cualquiera de dos especies de lagartos nativos de las regiones tropicales de América y 