{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "skipLibCheck": true
  },
  "include": [
    "src/contracts/**/*.js",
    "src/app/backgroundTaskCoordinator.js",
    "src/app/bookSessionController.js",
    "src/app/appShellController.js",
    "src/reader/readerContract.js"
  ]
}
